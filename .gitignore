# Dependencies
node_modules/

# Python virtualenv used by one-off spikes (e.g. the UNISAL ONNX export
# under scripts/unisal-onnx-export.py). Never part of the shipped app.
.venv/
__pycache__/
*.pyc

# Build / dev artefacts
dist/
.vite/
coverage/

# Playwright run artefacts (traces, screenshots, reports). Everything
# inside /tests/e2e/ that is NOT a *.spec.js file is regenerated per
# run and should not be committed.
test-results/
playwright-report/
blob-report/
.playwright/
tests/e2e/.cache/

# Logs
*.log

# OS cruft
.DS_Store

# Model weights never live in the repo — they are fetched from the model
# CDN on first run and cached by the browser. The patterns below are a
# defence-in-depth against an accidental `git add .` after a local
# experiment. Reviewers should still reject any large binary that sneaks
# past these patterns; size-based thresholds cannot be expressed in a
# .gitignore file and must be enforced out of band.
*.pb
*.onnx
*.bin
# Mirrored MSI-Net weights are populated by scripts/fetch-weights.sh
# at dev-time and by the Pages deploy workflow at build-time. Using
# `docs/models/*` rather than `docs/models/` so git still traverses
# the directory and the negation rule below can re-include specific
# subdirectories. (Git refuses to look inside a fully-ignored dir.)
docs/models/*
# Exception: the UNISAL ONNX artefact IS committed to the repo because
# GitHub Pages serves it directly and there is no CDN alternative for a
# hand-exported spike artefact. If V2 ships, this is the production home.
# Two negations are needed — one for the directory (so git traverses
# into it) and one for the specific file (so *.onnx above doesn't
# re-ignore it).
!docs/models/unisal/
!docs/models/unisal/*.onnx
docs/models/v3/
