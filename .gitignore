# Dependencies
node_modules/

# Python virtualenv used by one-off spikes (e.g. the UNISAL ONNX export
# under scripts/unisal-onnx-export.py). Never part of the shipped app.
.venv/
__pycache__/
*.pyc

# Build / dev artefacts
dist/
.vite/
coverage/

# Playwright run artefacts (traces, screenshots, reports). Everything
# inside /tests/e2e/ that is NOT a *.spec.js file is regenerated per
# run and should not be committed.
test-results/
playwright-report/
blob-report/
.playwright/
tests/e2e/.cache/

# Logs
*.log

# OS cruft
.DS_Store

# Model weights never live in the repo — they are fetched from a GitHub
# Release at deploy time (scripts/fetch-v3-model.sh) and cached locally.
# The patterns below are a defence-in-depth against an accidental
# `git add .` after a local experiment. Reviewers should still reject any
# large binary that sneaks past these patterns; size-based thresholds
# cannot be expressed in a .gitignore file and must be enforced out of band.
*.pb
*.onnx
*.bin
# Using `docs/models/*` rather than `docs/models/` so git still traverses
# the directory and negation rules below can re-include specific
# subdirectories. (Git refuses to look inside a fully-ignored dir.)
docs/models/*
# V3 MSI-Net model is NOT committed (57 MB). Use scripts/fetch-v3-model.sh
# locally; the deploy workflow fetches it before the Pages upload.
docs/models/v3/
.gstack/
